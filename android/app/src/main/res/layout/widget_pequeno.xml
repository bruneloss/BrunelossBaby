<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_widget"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ViewFlipper
        android:id="@+id/cena"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/fundo_cena"
        android:padding="2dp"
        android:autoStart="true"
        android:flipInterval="450">
        <ImageView android:id="@+id/q0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
        <ImageView android:id="@+id/q1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
        <ImageView android:id="@+id/q2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
        <ImageView android:id="@+id/q3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/fogo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❤️‍🔥" android:textSize="18sp" />
        <TextView android:id="@+id/dias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="0" android:textColor="#FF8A00" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/rotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="dias" android:textColor="@color/preto" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
